{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Iniciar EmoWell (F5)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "restart": true,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "URL: (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
