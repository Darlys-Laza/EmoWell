# Puerto del servidor Express
PORT=3000

# Cadena de conexión de MongoDB (Mongoose)
# Local: mongodb://127.0.0.1:27017/emowell
# Nube (Atlas): mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/emowell?retryWrites=true&w=majority
# (Nota: Si no se define o si MongoDB no está corriendo en la máquina, el sistema activa automáticamente el modo de persistencia local resiliente)
MONGODB_URI=mongodb://127.0.0.1:27017/emowell

# Clave de API externa de chat (opcional: si no se define, el backend usa el motor local de acompañamiento emocional)
# GEMINI_API_KEY=tu_clave_api_aqui
